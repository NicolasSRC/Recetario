# Copiar a .env y rellenar. El prefijo de todas las variables es RECETARIO_.

# --- Proveedor del LLM ---
# opencode: usa OpenCode local, sin llave de API (modelos gratuitos).
# openai:   usa cualquier API compatible con OpenAI.
RECETARIO_LLM_PROVIDER=opencode

# --- OpenCode local ---
RECETARIO_OPENCODE_MODEL=opencode/deepseek-v4.1-flash-free
RECETARIO_OPENCODE_AGENT=recetario-extractor
RECETARIO_OPENCODE_EXECUTABLE=opencode
RECETARIO_OPENCODE_TIMEOUT_S=300

# --- API compatible con OpenAI (solo si RECETARIO_LLM_PROVIDER=openai) ---
RECETARIO_LLM_API_KEY=
RECETARIO_LLM_MODEL=gpt-4o-mini
# RECETARIO_LLM_BASE_URL=https://api.openai.com/v1
RECETARIO_LLM_TEMPERATURE=0.0

# --- Validación y costo (RF-23, RNF-02) ---
RECETARIO_MAX_VALIDATION_RETRIES=2
RECETARIO_MAX_COST_USD_PER_VIDEO=0.25

# --- Transcripción local (opcional, requiere el extra [audio]) ---
RECETARIO_WHISPER_MODEL=small
RECETARIO_WHISPER_DEVICE=cpu
RECETARIO_WHISPER_COMPUTE_TYPE=int8

# --- F4: texto en pantalla (RF-12) ---
# frames_enabled: si false, el agente no descarga el video ni muestrea frames.
RECETARIO_FRAMES_ENABLED=true
RECETARIO_FRAME_INTERVAL_S=2.0
RECETARIO_MAX_FRAMES_PER_VIDEO=24
# tesseract: OCR local (requiere el binario y el extra [ocr]).
# vision:    API compatible con OpenAI; usa VISION_API_KEY o LLM_API_KEY.
# none:      desactiva la lectura de pantalla.
RECETARIO_SCREEN_TEXT_READER=tesseract
RECETARIO_TESSERACT_LANG=spa+eng
RECETARIO_TESSERACT_MIN_CONFIDENCE=40
RECETARIO_VISION_MODEL=gpt-4o-mini
RECETARIO_VISION_API_KEY=
# RECETARIO_VISION_BASE_URL=https://api.openai.com/v1
RECETARIO_VISION_COST_USD_PER_FRAME=0.0

# --- F4: agente (RA-03) ---
RECETARIO_MAX_AGENT_STEPS=8
# Costo estimado de cada extracción; se suma al tope por video.
RECETARIO_LLM_COST_USD_PER_EXTRACTION=0.0

# --- Archivos temporales (se borran al terminar, RF-14) ---
RECETARIO_TMP_DIR=data/tmp
